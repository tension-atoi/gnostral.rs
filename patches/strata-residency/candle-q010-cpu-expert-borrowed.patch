+#[test]
+fn q2k_copy_free_cpu_expert_projection_matches_owned_slice() -> candle_core::Result<()> {
+    let q = stack()?;
+    let values = (0..256)
+        .map(|j| (j as f32 - 127.0) / 384.0)
+        .collect::<Vec<_>>();
+    let xs = Tensor::from_vec(values, (1, 256), &Device::Cpu)?;
+    for expert in 0..3 {
+        let before = q.data()?.into_owned();
+        let old = QMatMul::from_qtensor(q.expert_slice_to(expert, &Device::Cpu)?)?
+            .forward(&xs)?
+            .to_vec2::<f32>()?;
+        let new = q.cpu_expert_matmul_k(expert, &xs)?
+            .expect("Q2K CPU source is supported")
+            .to_vec2::<f32>()?;
+        for (a, b) in new[0].iter().zip(&old[0]) {
+            assert!(a.is_finite());
+            assert!((a - b).abs() <= 1e-5 + 1e-5 * b.abs(), "{a} != {b}");
+        }
+        assert_eq!(q.data()?.as_ref(), before.as_slice(), "source bytes changed");
+    }
+    assert!(q.cpu_expert_matmul_k(3, &xs).is_err());
+    assert!(q.cpu_expert_matmul_k(
+        0, &Tensor::ones((1, 512), candle_core::DType::F32, &Device::Cpu)?
+    ).is_err());
+    Ok(())
+}
