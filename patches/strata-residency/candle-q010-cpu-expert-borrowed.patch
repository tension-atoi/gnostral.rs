+#[test]
+fn q3k_copy_free_cpu_expert_projection_matches_owned_slice() -> candle_core::Result<()> {
+    let values = (0..3 * 2 * 256)
+        .map(|i| ((i % 23) as f32 - 11.0) / 16.0)
+        .collect::<Vec<_>>();
+    let q = QTensor::quantize(
+        &Tensor::from_vec(values, (3, 2, 256), &Device::Cpu)?,
+        GgmlDType::Q3K,
+    )?;
+    let x = Tensor::ones((1, 256), candle_core::DType::F32, &Device::Cpu)?;
+    for expert in 0..3 {
+        let old = QMatMul::from_qtensor(q.expert_slice_to(expert, &Device::Cpu)?)?
+            .forward(&x)?.to_vec2::<f32>()?;
+        let new = q.cpu_expert_matmul_k(expert, &x)?
+            .expect("Q3K supported").to_vec2::<f32>()?;
+        for (a, b) in new[0].iter().zip(&old[0]) {
+            assert!(a.is_finite());
+            assert!((a - b).abs() <= 1e-5 + 1e-5 * b.abs(), "{a} != {b}");
+        }
+    }
+    Ok(())
+}
