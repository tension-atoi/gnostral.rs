+    /// Copy-free CPU Q2_K/Q3_K projection of one expert in a GGUF stack.
+    ///
+    /// The input borrow and packed weight borrow stay alive through the
+    /// synchronous kernel. Other quantization types retain the fallback path.
+    pub fn cpu_expert_matmul_k(&self, expert: usize, xs: &Tensor) -> Result<Option<Tensor>> {
+        let dtype = self.dtype();
+        if !matches!(dtype, GgmlDType::Q2K | GgmlDType::Q3K)
+            || !xs.device().is_cpu()
+            || xs.dtype() != DType::F32
+        {
+            return Ok(None);
+        }
+        let QStorage::Cpu(weights) = &self.storage else {
+            return Ok(None);
+        };
+        let (experts, rows, cols) = self.shape.dims3()?;
+        if expert >= experts {
+            crate::bail!("expert index {expert} out of bounds ({experts})");
+        }
+        let (batch, xs_cols) = xs.dims2()?;
+        if batch != 1 || xs_cols != cols || !xs.is_contiguous() {
+            crate::bail!("expert projection expects contiguous [1, hidden] F32");
+        }
+        let src_storage = xs.storage();
+        let Storage::Cpu(input) = &*src_storage else {
+            return Ok(None);
+        };
+        let offset = xs.layout().start_offset();
+        let src = input.as_slice::<f32>()?;
+        let lhs = src.get(offset..offset + cols)
+            .ok_or_else(|| crate::Error::Msg("expert input truncated".into()))?;
+
+        fn borrowed_projection<T: GgmlType>(
+            weights: &dyn QuantizedType,
+            experts: usize,
+            expert: usize,
+            rows: usize,
+            cols: usize,
+            lhs: &[f32],
+        ) -> Result<Tensor> {
+            if cols % T::BLCK_SIZE != 0 {
+                crate::bail!("expert dimension is not quantization-block aligned");
+            }
+            let blocks_per_expert = rows.checked_mul(cols / T::BLCK_SIZE)
+                .ok_or_else(|| crate::Error::Msg("expert block size overflow".into()))?;
+            let blocks = blocks_per_expert.checked_mul(experts)
+                .ok_or_else(|| crate::Error::Msg("expert stack overflow".into()))?;
+            let expected_bytes = blocks.checked_mul(std::mem::size_of::<T>())
+                .ok_or_else(|| crate::Error::Msg("expert byte size overflow".into()))?;
+            if expected_bytes != weights.storage_size_in_bytes() {
+                crate::bail!("expert packed storage differs from declared geometry");
+            }
+            let base = weights.as_ptr();
+            if !(base as usize).is_multiple_of(std::mem::align_of::<T>()) {
+                crate::bail!("expert packed storage alignment mismatch");
+            }
+            // SAFETY: weights owns an immutable contiguous block allocation, kept
+            // alive by &self for the entire synchronous projection. Validated
+            // geometry, byte size, alignment and expert index bound the slice.
+            let all = unsafe { std::slice::from_raw_parts(base as *const T, blocks) };
+            let start = expert.checked_mul(blocks_per_expert)
+                .ok_or_else(|| crate::Error::Msg("expert range overflow".into()))?;
+            let selected = &all[start..start + blocks_per_expert];
+            let mut out = vec![0f32; rows];
+            k_quants::matmul((1, cols, rows), lhs, selected, &mut out)?;
+            Tensor::from_vec(out, (1, rows), &Device::Cpu)
+        }
+
+        Ok(Some(match dtype {
+            GgmlDType::Q2K => borrowed_projection::<BlockQ2K>(
+                weights.as_ref(), experts, expert, rows, cols, lhs,
+            )?,
+            GgmlDType::Q3K => borrowed_projection::<BlockQ3K>(
+                weights.as_ref(), experts, expert, rows, cols, lhs,
+            )?,
+            _ => unreachable!("dtype checked above"),
+        }))
+    }
